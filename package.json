{
  "name": "ego-lite-windows",
  "version": "0.1.0",
  "description": "Standalone Windows-capable ego-lite runtime (Linux port over CDP) + GitHub Copilot skill. Drive a real Edge/Chrome browser from an agent with JS heredocs.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "ego-browser": "bin/ego-browser.cmd"
  },
  "scripts": {
    "verify": "node scripts/verify.mjs",
    "status": "node scripts/ego-browser-launch.mjs --status",
    "stop": "node scripts/ego-browser-launch.mjs --stop",
    "open": "node scripts/ego-browser-launch.mjs --open",
    "setup:copilot": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-copilot-skill.ps1",
    "doctor": "node scripts/ego-browser-launch.mjs --status"
  },
  "license": "MIT"
}
