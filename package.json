{
  "name": "ego-lite-windows",
  "version": "0.1.0",
  "description": "Standalone Windows-capable ego-lite runtime (Linux port over CDP) + GitHub Copilot skill. Drive a real Edge/Chrome browser from an agent with JS heredocs.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "ego-browser": "bin/ego-browser.cmd"
  },
  "scripts": {
    "verify": "node scripts/verify.mjs",
    "verify:personal": "node scripts/verify-personal.mjs",
    "verify:v1": "node scripts/verify-v1-engine.mjs",
    "status": "node runtime/ego-linux/bin/ego-browser.mjs --status",
    "stop": "node runtime/ego-linux/bin/ego-browser.mjs --stop",
    "open": "node runtime/ego-linux/bin/ego-browser.mjs --open",
    "setup:copilot": "scripts/install-copilot-skill.cmd",
    "doctor": "node runtime/ego-linux/bin/ego-browser.mjs --status"
  },
  "license": "MIT"
}
